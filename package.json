{
  "name": "amaran-physics",
  "version": "1.1.0",
  "description": "Amaran Layer 3 — Physics Simulation Console",
  "main": "dist/main/main.js",
  "scripts": {
    "backend": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "backend:docker": "docker build -t amaran-l3 . && docker run --rm -p 8000:8000 -v ${PWD}/app/data:/srv/amaran/app/data amaran-l3",
    "fetch:srtm": ".\\.venv\\Scripts\\python.exe scripts/fetch_srtm.py N34E077",
    "test:backend": ".\\.venv\\Scripts\\python.exe -m pytest",
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.main.json && vite build",
    "package": "electron-builder --publish never",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\""
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^18.15.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^3.1.0",
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "electron": "^24.1.2",
    "electron-builder": "^24.13.3",
    "typescript": "^5.0.4",
    "vite": "^4.3.2",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.amaran.physics",
    "productName": "AmaranPhysics",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "generic",
      "url": ""
    }
  }
}
